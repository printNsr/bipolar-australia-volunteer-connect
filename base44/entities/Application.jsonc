{
  "name": "Application",
  "type": "object",
  "properties": {
    "volunteer_id": {
      "type": "string",
      "description": "Volunteer record id"
    },
    "volunteer_name": {
      "type": "string",
      "description": "Volunteer full name, copied at match time"
    },
    "volunteer_email": {
      "type": "string",
      "description": "Volunteer email address, copied at match time"
    },
    "volunteer_phone": {
      "type": "string",
      "description": "Volunteer phone number, copied at match time"
    },
    "role_id": {
      "type": "string",
      "description": "JobRole record id"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "reviewing",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "applied"
    },
    "preferred_area": {
      "type": "string"
    },
    "applied_date": {
      "type": "string",
      "format": "date"
    },
    "hours_required": {
      "type": "number"
    }
  },
  "required": [
    "volunteer_id"
  ]
}