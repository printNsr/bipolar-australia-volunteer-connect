{
  "name": "Creation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "landmark": {
      "type": "string",
      "description": "Landmark id this creation belongs to"
    },
    "creator_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "artwork",
        "story",
        "photo",
        "music",
        "poem",
        "other"
      ],
      "default": "story"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Source Studio project id when published from Studio"
    }
  },
  "required": [
    "title",
    "landmark"
  ]
}