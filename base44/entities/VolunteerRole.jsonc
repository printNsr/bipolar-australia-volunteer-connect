{
  "name": "VolunteerRole",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "clinical",
        "technology",
        "communications",
        "administration",
        "support",
        "events",
        "research"
      ]
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hours_per_week": {
      "type": "number"
    },
    "duration_weeks": {
      "type": "number"
    },
    "is_remote": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "volunteers_needed": {
      "type": "number",
      "default": 1
    },
    "volunteers_filled": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "description",
    "category"
  ]
}