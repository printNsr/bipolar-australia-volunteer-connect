{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Volunteer full name"
    },
    "email_id": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "weekdays",
        "weekends",
        "evenings",
        "flexible"
      ]
    },
    "available_days": {
      "type": "array",
      "description": "Days of the week the volunteer is available",
      "items": {
        "type": "string",
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      }
    },
    "availability_slots": {
      "type": "array",
      "description": "Exact availability per day, used for matching volunteers to job roles",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "start_time": {
            "type": "string",
            "description": "24-hour start time, HH:MM"
          },
          "end_time": {
            "type": "string",
            "description": "24-hour end time, HH:MM"
          },
          "hours": {
            "type": "number",
            "description": "Hours available in this slot"
          }
        },
        "required": [
          "day",
          "start_time",
          "end_time"
        ]
      }
    },
    "available_time": {
      "type": "string",
      "description": "Readable summary of available time, e.g. 'Mon 09:00-17:00, Sat 10:00-13:00'"
    },
    "total_weekly_hours": {
      "type": "number",
      "description": "Sum of hours across all availability slots"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone the availability times refer to"
    },
    "available_from": {
      "type": "string",
      "description": "Preferred start time (HH:MM)"
    },
    "available_to": {
      "type": "string",
      "description": "Preferred end time (HH:MM)"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the volunteer registered"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "screening",
        "active",
        "inactive"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email_id"
  ]
}