{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Volunteer full name"
    },
    "email_id": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "weekdays",
        "weekends",
        "evenings",
        "flexible"
      ]
    },
    "available_days": {
      "type": "array",
      "description": "Days of the week the volunteer is available",
      "items": {
        "type": "string",
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      }
    },
    "available_from": {
      "type": "string",
      "description": "Preferred start time (HH:MM)"
    },
    "available_to": {
      "type": "string",
      "description": "Preferred end time (HH:MM)"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the volunteer registered"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "screening",
        "active",
        "inactive"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email_id"
  ]
}