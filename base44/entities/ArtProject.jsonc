{
  "name": "ArtProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "story": {
      "type": "string",
      "description": "The idea or story behind the artwork"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "skills_wanted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "sketching",
        "creating",
        "review",
        "published"
      ],
      "default": "idea"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "canvas": {
      "type": "object",
      "description": "Shared canvas content",
      "properties": {
        "strokes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "preview_url": {
      "type": "string",
      "description": "Uploaded snapshot of the artwork"
    },
    "reach_count": {
      "type": "number",
      "default": 0,
      "description": "People the published artwork reached"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "explore_landmark": {
      "type": "string",
      "description": "Explore landmark where this artwork was published"
    }
  },
  "required": [
    "title",
    "creator_name"
  ]
}